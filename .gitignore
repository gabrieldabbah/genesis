# secrets — never commit
.env
.env.*
!.env.example
# ...but the scaffolding templates are not secrets — keep them tracked
!templates/env/.env.*
*.pem
*.key

# os / editor
.DS_Store
*.bak

# local Claude Code config — personal, never committed…
.claude/*
# …except the hooks genesis itself uses and their wiring, so working ON genesis dogfoods what it ships.
# settings.local.json and .claude/skills/ stay personal and ignored.
!.claude/hooks/
!.claude/settings.json

# local scratch
.scratch/*
!.scratch/README.md
