{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.dev)",
      "Read(./.env.development)",
      "Read(./.env.prod)",
      "Read(./.env.production)",
      "Read(./.env.test)",
      "Read(./.env.staging)",
      "Read(./.env.*.local)",
      "Read(./**/.env)",
      "Read(//**/.env)",
      "Read(//**/.env.local)",
      "Read(//**/.env.dev)",
      "Read(//**/.env.development)",
      "Read(//**/.env.prod)",
      "Read(//**/.env.production)",
      "Read(//**/.env.test)",
      "Read(//**/.env.staging)",
      "Read(//**/.env.*.local)",
      "Read(**/secrets/**)",
      "Read(./secrets/**)",
      "Read(./**/*.key)",
      "Read(./**/*.pem)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.netrc)",
      "Read(~/.npmrc)",
      "Read(~/.config/git/**)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/todo-archive-reminder.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
