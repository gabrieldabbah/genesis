// Template for a scaffolded project's .claude/settings.json.
// Genesis fills this at runtime from the interview — do not ship it verbatim into a project.
//
// No OS sandbox by default. What protects this project is the deny rules below, the human gate on
// commit/push/deploy, and Claude Code's own permission mode. A sandbox tight enough to matter also blocks
// `pnpm install`, and a control that blocks ordinary work gets switched off — at which point it protects
// nothing. See skills/genesis/reference.md §Permissions for how to turn one on properly if you want it.
{
  "permissions": {
    // What a Read deny rule actually covers, per https://code.claude.com/docs/en/permissions §Read and Edit,
    // read on 2026-07-29 against Claude Code 2.1.220:
    //   - the Read tool, and best-effort the other built-in readers, @file mentions, and IDE selections;
    //   - the Edit tool on the same path, including creating a file there (2.1.208 and later);
    //   - the file-reading Bash commands Claude Code recognises — `cat`, `head`, `tail`, `sed`.
    // What it does NOT cover: a program that opens the file itself — a node or python script, or any other
    // subprocess reading indirectly. Only an OS sandbox stops those. State that boundary honestly rather than
    // calling this a wall.
    //
    // Env files are listed by name, not as `.env.*`, and that is load-bearing. A deny rule cannot carry an
    // exception: a broader deny beats a narrower allow, so `.env.example` can only stay reachable by never
    // being denied. It has to stay reachable — it is the one committed env file, it holds variable names with
    // empty values by construction, and this build writes each integration's keys into it after this settings
    // file already exists. A `.env.*` glob makes the file the build is instructed to maintain both unreadable
    // and unwritable, and the failure lands mid-build with no explanation.
    //
    // So: any further env filename this project invents goes in this list, in both spellings, when it is
    // created. `./x` is the project-relative anchor (identical to bare `x`); `//**/x` is the absolute one that
    // also catches a copy outside the project and, on Windows, every drive.
    "deny": [
      "Read(./.env)", "Read(./**/.env)", "Read(//**/.env)",
      "Read(./.env.local)", "Read(./**/.env.local)", "Read(//**/.env.local)",
      "Read(./.env.dev)", "Read(./**/.env.dev)", "Read(//**/.env.dev)",
      "Read(./.env.development)", "Read(./**/.env.development)", "Read(//**/.env.development)",
      "Read(./.env.test)", "Read(./**/.env.test)", "Read(//**/.env.test)",
      "Read(./.env.staging)", "Read(./**/.env.staging)", "Read(//**/.env.staging)",
      "Read(./.env.prod)", "Read(./**/.env.prod)", "Read(//**/.env.prod)",
      "Read(./.env.production)", "Read(./**/.env.production)", "Read(//**/.env.production)",
      "Read(./.env.*.local)", "Read(./**/.env.*.local)", "Read(//**/.env.*.local)",
      "Read(./secrets/**)", "Read(**/secrets/**)",
      "Read(./**/*.pem)", "Read(./**/*.key)", "Read(**/*.pem)", "Read(**/*.key)",
      "Read(~/.ssh/**)", "Read(~/.aws/**)", "Read(~/.gnupg/**)", "Read(~/.config/gh/**)",
      "Read(~/.netrc)", "Read(~/.npmrc)", "Read(~/.config/git/**)"
      // {{INTEGRATION_SECRET_PATHS}} — env files / key paths for chosen integrations
    ],
    // Outward-facing actions stay with the operator no matter how autonomous the run is.
    "ask": [
      "Bash(git push:*)",
      "Bash(gh pr merge:*)"
      // {{DEPLOY_COMMANDS}} — the chosen host's deploy command
    ]
  },
  // The one hook genesis installs. It checks two facts in docs/TODO.md: a heading section that is entirely
  // complete, with no open items, and still in the live file rather than the dated archive; and a ticked
  // item that is a settled question ("confirm/verify X", or stamped CONFIRMED/VERIFIED) hiding inside a
  // section that still holds open work. Needs docs/TODO-done.md to exist. Fails open, blocks at most once
  // per violation set, disarmed with `touch .claude/todo-archive.off`.
  //
  // The test for adding any other hook: does it check a fact, or override a decision? A hook that refuses to
  // let a turn end, or denies the question tool, overrides a decision — it removes the ability to stop and the
  // ability to ask, which is how an agent ends up confidently doing the wrong thing.
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/todo-archive-reminder.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
