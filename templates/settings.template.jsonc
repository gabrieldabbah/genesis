// Template for a scaffolded project's .claude/settings.json.
// Genesis fills this at runtime from the interview — do not ship it verbatim into a project.
//
// No OS sandbox by default. What protects this project is the deny rules below, the human gate on
// commit/push/deploy, and Claude Code's own permission mode. A sandbox tight enough to matter also blocks
// `pnpm install`, and a control that blocks ordinary work gets switched off — at which point it protects
// nothing. See skills/genesis/reference.md §Permissions for how to turn one on properly if you want it.
{
  "permissions": {
    // Blocks the Read tool. Note the boundary honestly: this does NOT stop a shell command. `cat .env` from
    // Bash is not covered by any rule here — only an OS sandbox does that. Secret handling from the shell is
    // a rule stated in CLAUDE.md, not a control, and CLAUDE.md § Secrets says so plainly.
    //
    // Each project-relative path is listed in every spelling Claude Code accepts — bare (`.env`),
    // explicitly-relative (`./.env`), and recursive in both forms (`./**/` and `//**/`). Which spelling a
    // given build's matcher honours is a version-sensitive detail, and the cost is asymmetric: a redundant
    // rule costs a line, a rule that silently matches nothing leaves `.env` readable while this file claims
    // otherwise. Redundancy here is deliberate — do not "tidy" it to one form without testing the survivor
    // against a real file on the target build.
    "deny": [
      "Read(.env)", "Read(.env.*)",
      "Read(./.env)", "Read(./.env.*)",
      "Read(./**/.env)", "Read(./**/.env.*)",
      "Read(//**/.env)", "Read(//**/.env.*)",
      "Read(**/.env)", "Read(**/.env.*)",
      "Read(secrets/**)", "Read(./secrets/**)", "Read(**/secrets/**)",
      "Read(**/*.pem)", "Read(**/*.key)", "Read(./**/*.pem)", "Read(./**/*.key)",
      "Read(~/.ssh/**)", "Read(~/.aws/**)", "Read(~/.gnupg/**)", "Read(~/.config/gh/**)",
      "Read(~/.netrc)", "Read(~/.npmrc)", "Read(~/.config/git/**)"
      // {{INTEGRATION_SECRET_PATHS}} — env files / key paths for chosen integrations
    ],
    // Outward-facing actions stay with the operator no matter how autonomous the run is.
    "ask": [
      "Bash(git push:*)",
      "Bash(gh pr merge:*)"
      // {{DEPLOY_COMMANDS}} — the chosen host's deploy command
    ]
  },
  // The one hook genesis installs. It checks a fact: a heading section in docs/TODO.md that is entirely
  // complete, with no open items, and still in the live file rather than the dated archive. Needs
  // docs/TODO-done.md to exist. Fails open, blocks at most once per violation set, disarmed with
  // `touch .claude/todo-archive.off`.
  //
  // The test for adding any other hook: does it check a fact, or override a decision? A hook that refuses to
  // let a turn end, or denies the question tool, overrides a decision — it removes the ability to stop and the
  // ability to ask, which is how an agent ends up confidently doing the wrong thing.
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/todo-archive-reminder.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
